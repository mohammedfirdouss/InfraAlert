# Database (ADR 0003). Inside docker compose use host "db" and port 5432.
DATABASE_URL=postgresql+psycopg://infraalert:infraalert@localhost:5433/infraalert

# Citizen submissions (ADR 0007). This is Cloudflare's always-pass *test* secret;
# production uses the real Turnstile secret from Secret Manager.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# HMAC key for rate-limit keys. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
RATE_LIMIT_SECRET=change-me
RATE_LIMIT_PER_HOUR=5
# 0 when Cloud Run is hit directly, 1 behind an external HTTPS load balancer.
TRUSTED_PROXY_HOPS=0

# Photo storage (ADR 0008): "local" for development, "gcs" in production.
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=var/uploads
PUBLIC_BASE_URL=http://localhost:8000
GCS_BUCKET=

# Report processing queue (ADR 0002): "log" for development, "cloud_tasks" in production.
TASKS_BACKEND=log
CLOUD_TASKS_QUEUE=
TASKS_TARGET_URL=
TASKS_SERVICE_ACCOUNT=

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-flash-latest

ISSUE_DETECTION_URL=http://issue-detection:8081
PRIORITY_ANALYSIS_URL=http://priority-analysis:8082
RESOURCE_COORDINATION_URL=http://resource-coordination:8083
PLATFORM_INTEGRATION_URL=http://platform-integration:8084
MCP_SERVER_URL=http://mcp-server:8080

FIRESTORE_COLLECTION_REPORTS=reports
FIRESTORE_COLLECTION_TEAMS=teams

BIGQUERY_DATASET=infraalert
