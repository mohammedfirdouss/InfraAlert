# InfraAlert backend settings (read by webapp/backend/infraalert/config.py).
# Copy to .env for local development (`make env`). The defaults below run
# everything locally: no Google Cloud account is needed.
# Frontend build settings (VITE_*) live in webapp/frontend/.env.example.

# Database (ADR 0003). Inside docker compose use host "db" and port 5432.
DATABASE_URL=postgresql+psycopg://infraalert:infraalert@localhost:5433/infraalert

# Citizen submissions (ADR 0007). This is Cloudflare's always-pass *test* secret;
# production uses the real Turnstile secret from Secret Manager.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# HMAC key for rate-limit keys, and the signing key for unsubscribe links in update emails:
# rotating it breaks unsubscribe links in emails already sent.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
RATE_LIMIT_SECRET=change-me
RATE_LIMIT_PER_HOUR=5
# 0 when Cloud Run is hit directly, 1 behind an external HTTPS load balancer.
TRUSTED_PROXY_HOPS=0

# Photo storage (ADR 0008): "local" for development, "gcs" in production.
STORAGE_BACKEND=local
# local only: where uploads are written (relative to the backend's working directory).
LOCAL_UPLOAD_DIR=var/uploads
# The public origin citizens use: links in update emails, and (local storage) upload URLs.
# With `make dev` that's the Vite server, which proxies /api and /dev to the backend.
PUBLIC_BASE_URL=http://localhost:5173
# gcs only: the private photo bucket.
GCS_BUCKET=

# Report processing queue (ADR 0002). "inline" (development) processes reports in
# a background thread of the web process; "cloud_tasks" in production.
TASKS_BACKEND=inline
# cloud_tasks only: queue path (projects/<p>/locations/<l>/queues/<q>), this
# service's public URL (task targets and token audiences derive from it), and the
# service account that signs task/scheduler tokens.
CLOUD_TASKS_QUEUE=
SERVICE_URL=
TASKS_SERVICE_ACCOUNT=

# Extraction (ADR 0004). "disabled" (development) sends every report to human
# triage; "vertex" calls Gemini on Vertex AI with GOOGLE_CLOUD_PROJECT/REGION.
EXTRACTOR_BACKEND=disabled
# vertex only. Must be a Vertex AI model id (not a Gemini API alias), e.g. a
# versioned "gemini-…" id listed in the Vertex AI Model Garden for your region.
GEMINI_MODEL=your-vertex-gemini-model-id

# Staff sign-in (ADR 0007). "dev" (development only) accepts any seeded staff
# email; "identity_platform" verifies Google Identity Platform ID tokens.
STAFF_AUTH_BACKEND=dev
# identity_platform only: restrict sign-in to one provider, e.g. "oidc.city-sso".
STAFF_SIGN_IN_PROVIDER=

# Citizen email updates (ADR 0007). "console" (development) writes each email to
# LOCAL_OUTBOX_DIR instead of sending it; "smtp" sends via any SMTP provider.
EMAIL_BACKEND=console
EMAIL_FROM="InfraAlert <no-reply@infraalert.local>"
LOCAL_OUTBOX_DIR=var/outbox
# smtp only. SMTP_PASSWORD comes from Secret Manager in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Sensitive places import from OpenStreetMap: the city's bounding box as
# "south,west,north,east" (default: Nairobi) and the Overpass API endpoint.
CITY_BBOX=-1.45,36.65,-1.16,37.10
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Google Cloud: needed for EXTRACTOR_BACKEND=vertex (project + region) and
# STAFF_AUTH_BACKEND=identity_platform (project). On Cloud Run, credentials come
# from the service account; locally use `gcloud auth application-default login`
# or point GOOGLE_APPLICATION_CREDENTIALS at a key file.
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
