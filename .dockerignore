# Build context is the repo root (docker build -f webapp/Dockerfile .).
# Allow-list: only the backend and frontend sources go into the context.
*
!webapp/backend
!webapp/frontend

# …minus local artefacts inside them.
**/node_modules
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.venv
**/var
**/.env
**/.env.*
!webapp/frontend/.env.example
webapp/frontend/dist
webapp/backend/tests
**/.DS_Store
