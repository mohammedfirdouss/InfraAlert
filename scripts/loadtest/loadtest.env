# Local load-test configuration. No secrets: every value here is for a
# throwaway local database. Never use these backends in production
# (the app refuses to start with them when TASKS_BACKEND=cloud_tasks).
# Its own database on the local server, recreated by run_steps.sh on every run.
DATABASE_URL=postgresql+psycopg://infraalert:infraalert@localhost:5433/infraalert_loadtest
RATE_LIMIT_SECRET=load-test-only
# Each simulated citizen sends its own X-Forwarded-For address, so the
# per-client limit still runs on every request; this just keeps it from
# rejecting a client that submits many reports during a long run.
RATE_LIMIT_PER_HOUR=1000000
CAPTCHA_BACKEND=disabled
EXTRACTOR_BACKEND=fake
TASKS_BACKEND=inline
STORAGE_BACKEND=local
EMAIL_BACKEND=console
STAFF_AUTH_BACKEND=dev
