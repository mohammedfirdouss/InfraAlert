# Throwaway settings for verifying a change locally. No secrets.
DATABASE_URL=postgresql+psycopg://infraalert:infraalert@localhost:5433/infraalert_verify
RATE_LIMIT_SECRET=verify-only
RATE_LIMIT_PER_HOUR=50
CAPTCHA_BACKEND=disabled
EXTRACTOR_BACKEND=fake
TASKS_BACKEND=inline
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=var/verify/uploads
LOCAL_OUTBOX_DIR=var/verify/outbox
EMAIL_BACKEND=console
STAFF_AUTH_BACKEND=dev
