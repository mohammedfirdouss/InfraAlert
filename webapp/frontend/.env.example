
# MapTiler key (tiles + address search). Restrict it to your domains in the MapTiler
VITE_MAPTILER_KEY=

# Cloudflare Turnstile site key. Empty uses Cloudflare's always-pass test key,
# which matches the backend's test secret in the root .env.example.
VITE_TURNSTILE_SITE_KEY=

# Where the map opens before the citizen's location is known ("lat,lng").
VITE_MAP_DEFAULT_CENTER=-1.2921,36.8219

# Emergency number shown on the report form.
VITE_EMERGENCY_NUMBER=112

# Staff sign-in. "dev" (default) signs in by typing a seeded staff email; use
# "identity_platform" with the Firebase web config and the city's OIDC provider id.
VITE_STAFF_AUTH=dev
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_STAFF_SIGN_IN_PROVIDER=
